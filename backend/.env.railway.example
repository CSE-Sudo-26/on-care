# Railway 배포용 환경변수 템플릿
# ─────────────────────────────────────────────────────────────────────────
# 사용법: Railway 프로젝트 > 백엔드 서비스 > Variables 탭에 아래 값을 넣는다.
#   · 서비스의 Root Directory 는 반드시 "backend" 로 지정(그래야 railway.json·
#     Dockerfile 을 찾는다).
#   · Postgres 는 "pgvector" 템플릿으로 추가한다(0007 마이그레이션이 vector 타입을
#     쓰므로 pgvector 확장이 있어야 한다). 일반 Postgres 를 썼다면 DB 콘솔에서
#     한 번:  CREATE EXTENSION IF NOT EXISTS vector;
#   · 이 파일은 예시일 뿐 커밋되는 값이 아니다(실제 시크릿은 Railway 에만 저장).

ENV=prod

# Railway Postgres 플러그인의 참조 변수. 플랫폼은 postgresql://… 형태로 주지만,
# 앱이 psycopg v3 로 자동 정규화(config.sqlalchemy_database_url)하므로 이대로 OK.
DATABASE_URL=${{Postgres.DATABASE_URL}}

# 운영은 Alembic 이 스키마의 정답 → 앱 기동 시 create_all() 비활성.
AUTO_CREATE_TABLES=false

# 반드시 교체:  openssl rand -hex 32  (기본값이면 prod 기동이 차단된다)
JWT_SECRET=CHANGE_ME_run_openssl_rand_hex_32

# 프론트(GitHub Pages) 도메인. prod 는 와일드카드('*') 금지.
CORS_ALLOW_ORIGINS=https://ewhasudo.zapto.org

# 오늘/어제 등 날짜 라벨을 KST 기준으로 계산.
TZ=Asia/Seoul

# 운영은 데모 시드 끄기 권장. 켜려면 DEMO_LOGIN_PASSWORD 를 12자+ 로.
SEED_DEMO_DATA=false

# AI — 없으면 stub 폴백(기동은 됨). 실제 코치/인식을 쓰려면 채운다.
RECOGNIZER=gemini
COACH_LLM=gemini
EMBEDDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# 임베딩 차원(Gemini gemini-embedding-001 = 768)
EMBED_DIM=768

# 장소(O2O) 실검색 — 없으면 시드 폴백.
KAKAO_REST_API_KEY=

# ─────────────────────────────────────────────────────────────────────────
# 참고: PORT 는 Railway 가 자동 주입한다. 직접 설정하지 말 것
#       (start.sh 가 ${PORT:-8000} 로 바인딩한다).
